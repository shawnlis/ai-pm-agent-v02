# Copy to .env for local use. Do not commit real values.

LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=ai-pm-agent-v02
OPENROUTER_MAX_TOKENS=1800
OPENROUTER_TEMPERATURE=0.2

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=2500
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=medium

WEB_DISCOVERY_ENABLED=1
EVIDENCE_SEARCH_ENABLED=1
OFFICIAL_SOURCE_SEARCH_ENABLED=1
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
SERPAPI_API_KEY=

FACT_CACHE_ENABLED=1
FACT_CACHE_PATH=data/fact_cache/facts.sqlite
FACT_EXTRACT_PROVIDER=deepseek
FACT_EXTRACT_MODEL=deepseek-v4-flash

REUSE_TODAY_OUTPUTS=1
CHOKEPOINT_SCOUT_ENABLED=1
MAX_PEERS=5
